# Copie este arquivo para .env e preencha. O .env fica só no seu computador (o git ignora).

# Chave da Gemini API (gratuita): https://aistudio.google.com -> "Get API key".
# Sem chave, o app funciona normalmente e mostra as dicas por regra no lugar do feedback escrito pela IA.
GEMINI_API_KEY=

# Opcional: modelo do Gemini usado no feedback. Vazio = padrão do app.
GEMINI_MODEL=
